APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=checkmate_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: corre Mailpit (https://mailpit.axllent.org, puerto SMTP 1025 por defecto,
# UI en http://localhost:8025) y no necesitas usuario/password. Si prefieres Mailtrap,
# reemplaza host/puerto/usuario/password con los de tu sandbox.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="checkmate@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOVERNANCE_BASE_URL=http://localhost:8001/api/v1
GOVERNANCE_POPUP_URL=http://localhost:8001/governance/auth
GOVERNANCE_CLIENT_ID=governance-web-local
GOVERNANCE_CLIENT_SECRET=governance-web-secret
GOVERNANCE_AUTH_CACHE_TTL=120
GOVERNANCE_WEB_CALLBACK_URL=http://localhost:8000/auth/callback

# Notificaciones a tutores por WhatsApp (Twilio). Vacío = deshabilitado (no manda nada,
# no truena). En el sandbox de Twilio (https://console.twilio.com, WhatsApp Sandbox)
# cada tutor debe mandar "join <código>" por WhatsApp una vez antes de poder recibir
# mensajes. TWILIO_WHATSAPP_FROM va con el prefijo "whatsapp:", ej. whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_DEFAULT_COUNTRY_CODE=52
